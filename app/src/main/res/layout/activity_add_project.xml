<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tên dự án -->
        <EditText
            android:id="@+id/edtProjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Tên dự án"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Mô tả dự án -->
        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:minHeight="48dp"
            android:hint="Mô tả dự án"
            android:gravity="top"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Mức độ ưu tiên -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mức độ ưu tiên"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cao" />

            <RadioButton
                android:id="@+id/rbMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trung bình"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thấp" />
        </RadioGroup>

        <!-- Ngày bắt đầu và kết thúc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Ngày bắt đầu" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnEndDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="Ngày kết thúc" />
        </LinearLayout>

        <!-- Tìm thành viên -->
        <EditText
            android:id="@+id/edtMember"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Nhập tên thành viên để giao việc"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAddMember"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="THÊM"
            android:layout_marginBottom="8dp" />

        <!-- Danh sách thành viên -->
        <LinearLayout
            android:id="@+id/memberContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <!-- Nút tạo dự án -->
        <Button
            android:id="@+id/btnCreateProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="TẠO DỰ ÁN"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
